---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "subtitle": {{ post.subtitle | default: '' | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 220 | jsonify }},
    "tags": {{ post.tags | default: empty | jsonify }},
    "categories": {{ post.categories | default: empty | jsonify }},
    "date": {{ post.date | date: '%B %-d, %Y' | jsonify }},
    "url": {{ post.url | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
